# Everything here is optional. The site runs with none of it set; each widget
# shows its own empty state until its integration is configured.

# Canonical URL, used for link previews. On Vercel the production URL is picked up automatically.
NEXT_PUBLIC_SITE_URL=

# Discord user ID for the profile card (Lanyard). Defaults to the ID in data/site.ts.
DISCORD_ID=

# Last.fm recently-played list. Get a key at https://www.last.fm/api/account/create
# Server-side only: the key never reaches the browser.
LASTFM_API_KEY=
LASTFM_USERNAME=

# Guestbook moderation. Visit /?admin=YOUR_SECRET once to enable delete buttons.
# When unset, deleting is disabled entirely.
ADMIN_SECRET=

# Salt for hashing visitor IPs (visit counter and guestbook cooldown). Any random string.
HASH_SALT=

# Shared storage for the guestbook and visit counter (Upstash Redis REST).
# Required on serverless hosts such as Vercel, whose filesystem doesn't persist.
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN, which also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Without Upstash, data is kept in a JSON file in this directory (default: .data).
# Good for `npm run dev` and for a long-running server (pm2, see ecosystem.config.js).
DATA_DIR=
