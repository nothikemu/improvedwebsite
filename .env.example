# Everything here is optional. The site runs with none of it set.

# Canonical URL, used for link previews. On Vercel the production URL is picked up automatically.
NEXT_PUBLIC_SITE_URL=

# GitHub token for the project list. Without one, requests are unauthenticated
# (60/hour per server IP), which shared hosting IPs can run out of.
# A fine-grained token with no extra permissions (public data only) is enough.
GITHUB_TOKEN=

# Shared guestbook storage (Upstash Redis REST). Without these, the guestbook
# runs in local mode: entries stay in each visitor's own browser.
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN, which also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Salt for the hashed visitor key used by the guestbook's rate limit. Any random string.
GUESTBOOK_SALT=

# Testing only: point the GitHub client at a local fixture server.
# GITHUB_API_URL=http://localhost:8787
